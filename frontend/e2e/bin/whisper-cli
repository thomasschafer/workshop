#!/bin/sh
# Stands in for whisper.cpp's whisper-cli: hears "undo" in any WAV recording it's given.
while [ $# -gt 0 ]; do
  if [ "$1" = "--file" ]; then file=$2; fi
  shift
done
head -c 4 "$file" | grep -q RIFF || { echo "not a WAV recording: $file" >&2; exit 1; }
# As long as Whisper takes, roughly, so a press can come while another is being heard.
sleep 0.5
echo " undo"
