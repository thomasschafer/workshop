 import datetime
 
 LOAN_DAYS = 21
+RENEWAL_DAYS = 14
+MAX_RENEWALS = 2
 
 
 class LoanError(Exception):
@@ -14,6 +16,7 @@ class Loan:
         self.book_id = book_id
         self.member = member
         self.due = due
+        self.renewals = 0
 
 
 class Loans:
@@ -35,6 +38,20 @@ class Loans:
         self.out[book_id] = loan
         return loan
 
+    def renew(self, book_id, member, today):
+        """Renews a loan for another `RENEWAL_DAYS` days, up to `MAX_RENEWALS` times, unless
+        it's overdue, or someone is waiting for the book."""
+        loan = self.out[book_id]
+        if loan.member != member:
+            raise LoanError("only the borrower can renew a loan")
+        if loan.renewals > MAX_RENEWALS:
+            raise LoanError("that loan can't be renewed again")
+        if loan.due < today:
+            raise LoanError("an overdue loan can't be renewed")
+        loan.due = today + datetime.timedelta(days=RENEWAL_DAYS)
+        loan.renewals += 1
+        return loan
+
     def give_back(self, book_id):
         del self.out[book_id]
 
